# Copia este archivo como `.env` y ajusta los valores.
PORT=4000
NODE_ENV=development
# Ruta del archivo SQLite (relativa a /server)
DB_PATH=./data/mywallet.db
# Origen permitido para CORS (URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173
# Formato de moneda usado en los reportes PDF/Excel
APP_LOCALE=es-CO
APP_CURRENCY=COP
